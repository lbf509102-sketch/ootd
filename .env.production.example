PORT=3001
DATABASE_PATH=./server/data/app.db
UPLOAD_DIR=./server/uploads
CORS_ORIGIN=https://your-domain.com
JSON_LIMIT=15mb

# For same-origin deployment behind Nginx, keep this empty.
VITE_API_BASE_URL=

# Login
DEV_LOGIN_CODE=
# Cheapest temporary friend-test mode:
# SMS_PROVIDER=mock
# DEV_LOGIN_CODE=246810
SMS_PROVIDER=mock
SMS_FALLBACK_TO_MOCK=true
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=
SMS_TEMPLATE_ID=smart-closet-login

# Image processing
IMAGE_QUALITY=88
GENERATED_IMAGE_QUALITY=94
ALLOW_LEGACY_SUBJECT_FALLBACK=false
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
ALIYUN_VIAPI_REGION_ID=cn-shanghai

# Try-on / vision
OPENAI_API_KEY=
DASHSCOPE_API_KEY=
GARMENT_AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
GARMENT_VISION_MODEL=qwen3.6-plus
TRYON_PROVIDER=aliyun
ALIYUN_DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com
ALIYUN_TRYON_MODEL=aitryon
ALIYUN_TRYON_RESOLUTION=-1
ALIYUN_TRYON_RESTORE_FACE=true
ALIYUN_TRYON_POLL_INTERVAL_MS=3000
ALIYUN_TRYON_POLL_LIMIT=20
TRYON_FALLBACK_TO_MOCK=true

# Optional webhook mode
TRYON_WEBHOOK_URL=
TRYON_WEBHOOK_TOKEN=
